using Gtk 4.0;

template $LibraryCompactFlowBoxChild: FlowBoxChild {
  margin-top: 3;
  margin-end: 3;
  margin-bottom: 3;
  margin-start: 3;

  Overlay overlay {
    margin-top: 3;
    margin-end: 3;
    margin-bottom: 3;
    margin-start: 3;

    child: Picture cover_picture {
      can-shrink: false;

      styles [
        "cover-dropshadow",
      ]
    };

    [overlay]
    Label name_label {
      valign: end;
      wrap: true;
      xalign: 0;

      styles [
        "library-thumbnail-name-label",
      ]
    }
  }
}
