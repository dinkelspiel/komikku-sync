using Gtk 4.0;

template $LibraryFlowBoxChild: FlowBoxChild {
  margin-top: 3;
  margin-end: 3;
  margin-bottom: 3;
  margin-start: 3;

  Grid grid {
    column-spacing: 4;
    row-spacing: 4;

    margin-top: 3;
    margin-end: 3;
    margin-bottom: 3;
    margin-start: 3;

    Picture cover_picture {
      name: "cover_picture";
      can-shrink: false;

      layout {
        row: 0;
        column: 0;
        column-span: 2;
      }

      styles [
        "cover-dropshadow",
      ]
    }

    Label name_label {
      name: "name_label";
      ellipsize: middle;
      hexpand: true;
      lines: 1;
      max-width-chars: 0;
      wrap: true;

      layout {
        row: 1;
        column: 0;
      }

      styles [
        "caption",
      ]
    }
  }
}
