<interface>
    <requires lib="gtk" version="4.0"/>
    <menu id="menu-reader">
        <section>
            <submenu>
                <attribute name="label" translatable="yes">Reading Mode</attribute>
                <section>
                    <attribute name="id">reading-mode-section</attribute>

                    <item>
                        <attribute name="label" translatable="yes">⬅ Right to Left</attribute>
                        <attribute name="action">app.reader.reading-mode</attribute>
                        <attribute name="target">right-to-left</attribute>
                    </item>
                    <item>
                        <attribute name="label" translatable="yes">➡ Left to Right</attribute>
                        <attribute name="action">app.reader.reading-mode</attribute>
                        <attribute name="target">left-to-right</attribute>
                    </item>
                    <item>
                        <attribute name="label" translatable="yes">⬇ Vertical</attribute>
                        <attribute name="action">app.reader.reading-mode</attribute>
                        <attribute name="target">vertical</attribute>
                    </item>
                    <item>
                        <attribute name="label" translatable="yes">⬇ Webtoon</attribute>
                        <attribute name="action">app.reader.reading-mode</attribute>
                        <attribute name="target">webtoon</attribute>
                    </item>
                </section>
            </submenu>
        </section>

       <section>
            <item>
                <attribute name="label" translatable="yes">Settings</attribute>
                <attribute name="action">app.reader.open-settings-dialog</attribute>
            </item>
        </section>

       <section>
            <item>
                <attribute name="label" translatable="yes">Save Page</attribute>
                <attribute name="action">app.reader.save-page</attribute>
            </item>
        </section>
    </menu>
</interface>
